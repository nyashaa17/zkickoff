{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "incremental": false,
    "jsx": "react-jsx",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".test-dist",
    "sourceMap": false,
    "target": "ES2022"
  },
  "include": ["lib/matches-data.ts", "lib/totalsports-api.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", ".test-dist"]
}
